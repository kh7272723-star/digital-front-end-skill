# Yosys synthesis script for NVMe I/O Data Path
read_verilog nvme_cmd_tracker.v
read_verilog nvme_prp_walker.v
read_verilog nvme_read_engine.v
read_verilog nvme_axi_adapter.v
read_verilog nvme_cq_post.v
read_verilog nvme_sq_fetch.v
read_verilog nvme_io_top.v

hierarchy -check -top nvme_io_top
proc
flatten
opt

# Latch detection
select -count t:$_DLATCH_* t:$_DLATCH_N_* t:$_DLATCH_P_* -list latch_cells
stat

# Critical path
ltp
